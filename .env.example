# Prebuilt image published by GitHub Actions. Set a version tag or digest to pin a release.
PANEL_IMAGE=ghcr.io/haoch1/lightsail-panel:latest
# Docker Compose publishes this local address and port.
PANEL_BIND=127.0.0.1
PANEL_PORT=8090
# Source-code startup defaults; Docker sets its internal host and port.
HOST=127.0.0.1
PORT=4180
DATA_DIR=data
# Set the exact browser origin when behind an HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://panel.example.com
# Optional: base64-encoded 32-byte key. If omitted, data/encryption.key is generated.
# Keep the encryption key together with its database when backing up or restoring data.
# ENCRYPTION_KEY=
