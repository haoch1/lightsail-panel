{
  "name": "lightsail-panel",
  "version": "1.7.6",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "license": "MIT",
  "type": "module",
  "bin": {
    "lightsail-panel": "./bin/lightsail-panel.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1 --port 4173 --strictPort",
    "dev:api": "node --watch bin/lightsail-panel.mjs",
    "build": "vite build",
    "start": "node bin/lightsail-panel.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "verify:aws": "node scripts/verify-aws.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-lightsail": "3.1147.0",
    "@aws-sdk/client-sts": "3.1147.0",
    "@smithy/node-http-handler": "4.12.1",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "lucide-react": "1.52.0",
    "node-pty": "1.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.9",
    "typescript": "7.0.2",
    "vite": "8.3.3"
  }
}
